{
  "info": {
    "_postman_id": "mikail-backend-studio-collection",
    "name": "⚡ Mikail Backend Studio - API & Middleware Testing",
    "description": "Koleksi lengkap request Postman untuk menguji seluruh endpoint CRUD, Anatomi HTTP, Status Codes, dan Middleware Auth pada server backend Express.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. CRUD Operations (REST API)",
      "item": [
        {
          "name": "1.1 [GET] Ambil Semua Data Items",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/items",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "items"]
            },
            "description": "Mengambil seluruh data dari database items.json."
          },
          "response": []
        },
        {
          "name": "1.2 [GET] Filter Data dengan Query Params",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/items?search=HTTP&completed=true",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "items"],
              "query": [
                {
                  "key": "search",
                  "value": "HTTP",
                  "description": "Pencarian kata kunci pada judul"
                },
                {
                  "key": "completed",
                  "value": "true",
                  "description": "Filter status selesai (true/false)"
                }
              ]
            },
            "description": "Menguji cara kerja req.query di server backend."
          },
          "response": []
        },
        {
          "name": "1.3 [GET] Ambil 1 Item by ID (Path Params)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/items/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "items", "1"]
            },
            "description": "Menguji cara kerja req.params.id di server backend."
          },
          "response": []
        },
        {
          "name": "1.4 [POST] Tambah Item Baru (JSON Body)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Belajar Postman API Testing\",\n  \"category\": \"Testing\",\n  \"completed\": false\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/items",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "items"]
            },
            "description": "Menambahkan data baru menggunakan req.body JSON ke server backend."
          },
          "response": []
        },
        {
          "name": "1.5 [PUT] Update Item by ID",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Belajar Postman API Testing (Sudah Selesai)\",\n  \"category\": \"Testing\",\n  \"completed\": true\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/items/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "items", "1"]
            },
            "description": "Memperbarui data item ID #1 di server."
          },
          "response": []
        },
        {
          "name": "1.6 [DELETE] Hapus Item by ID",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/items/3",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "items", "3"]
            },
            "description": "Menghapus data item ID #3 dari database server."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Anatomi HTTP Request (4 Jalur Data)",
      "item": [
        {
          "name": "2.1 [POST] Uji Params + Query + Headers + Body Sekaligus",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer contoh-token-miko-123",
                "description": "Header otentikasi kustom"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Miko Developer\",\n  \"tujuan\": \"Membedah anatomi HTTP di Postman\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/anatomy-demo/miko-param-99?sort=terbaru&limit=5",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "anatomy-demo", "miko-param-99"],
              "query": [
                {
                  "key": "sort",
                  "value": "terbaru"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "Endpoint khusus yang membedah dan membalas kembali semua nilai params, query, headers, dan body."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Middleware & Authentication Testing",
      "item": [
        {
          "name": "3.1 [GET] Uji Middleware 1: Akses Tanpa Token (Uji 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/auth-demo/protected",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth-demo", "protected"]
            },
            "description": "Menguji middleware otentikasi. Karena tidak menyertakan Authorization header, server akan menolak dengan status 401 Unauthorized."
          },
          "response": []
        },
        {
          "name": "3.2 [POST] Uji Middleware 2: Login untuk Mendapatkan Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"miko\",\n  \"password\": \"rahasia123\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/auth-demo/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth-demo", "login"]
            },
            "description": "Login ke server untuk mendapatkan string token 'secret-miko-token-2026'."
          },
          "response": []
        },
        {
          "name": "3.3 [GET] Uji Middleware 3: Akses dengan Bearer Token Valid (Uji 200)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "secret-miko-token-2026",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/auth-demo/protected",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth-demo", "protected"]
            },
            "description": "Menguji middleware otentikasi dengan Bearer Token yang valid. Server akan meloloskan request dengan status 200 OK."
          },
          "response": []
        },
        {
          "name": "3.4 [GET] Uji Middleware 4: Token Salah / Rusak (Uji 403)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "token-palsu-ngawur",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/auth-demo/protected",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth-demo", "protected"]
            },
            "description": "Menguji middleware saat token salah. Server akan menolak dengan status 403 Forbidden."
          },
          "response": []
        },
        {
          "name": "3.5 [GET] Uji Middleware 5: Simulasi Latency Delay",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/middleware-demo/latency?delay=1200",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "middleware-demo", "latency"],
              "query": [
                {
                  "key": "delay",
                  "value": "1200",
                  "description": "Delay dalam milidetik"
                }
              ]
            },
            "description": "Menguji middleware asynchronous yang menahan request selama 1.2 detik sebelum memanggil next()."
          },
          "response": []
        }
      ]
    },
